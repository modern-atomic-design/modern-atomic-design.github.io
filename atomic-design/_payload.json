[{"data":1,"prerenderedAt":273},["ShallowReactive",2],{"article-/atomic-design":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":5,"title":7,"description":5,"options":8,"body":17,"_type":267,"_id":268,"_source":269,"_file":270,"_stem":271,"_extension":272},"/atomic-design","",false,"Atomic Design",[9,13],{"label":10,"price":11,"data":12},"Basic",10,1000,{"label":14,"price":15,"data":16},"Premium",50,5000,{"type":18,"children":19,"toc":258},"root",[20,47,71,78,83,123,129,134,155,161,166,175,181,188,193,199,204,209,239,245],{"type":21,"tag":22,"props":23,"children":28},"element","div",{"style":24,"className":25},"minHeight: 288px",[26,27],"min-h-72","bg-transparent",[29],{"type":21,"tag":30,"props":31,"children":32},"p",{},[33,40],{"type":21,"tag":34,"props":35,"children":39},"img",{"alt":36,"src":37,"title":38},"atomic design overview","atomic-design-abstract-concrete.png","abstract to concrete",[],{"type":21,"tag":41,"props":42,"children":43},"em",{},[44],{"type":45,"value":46},"text","Atomic Design - Brad Frost",{"type":21,"tag":30,"props":48,"children":49},{},[50,52,61,63,69],{"type":45,"value":51},"This article is based on the work of ",{"type":21,"tag":53,"props":54,"children":58},"a",{"href":55,"rel":56},"https://atomicdesign.bradfrost.com/",[57],"nofollow",[59],{"type":45,"value":60},"Brad Frost",{"type":45,"value":62},". You'll find more detailled insights and helpful examples in his ",{"type":21,"tag":53,"props":64,"children":66},{"href":55,"rel":65},[57],[67],{"type":45,"value":68},"book",{"type":45,"value":70},".",{"type":21,"tag":72,"props":73,"children":75},"h3",{"id":74},"atoms",[76],{"type":45,"value":77},"Atoms",{"type":21,"tag":30,"props":79,"children":80},{},[81],{"type":45,"value":82},"Atoms are the very basic building blocks of a Design System. They cannot be divided into smaller blocks. In the context of Web Development, Atoms are basically the same as the available HTML tags, but can also be extended by e.g. Icon.",{"type":21,"tag":22,"props":84,"children":94},{"className":85},[86,87,88,89,90,91,92,93],"bg-gray-100","rounded-lg","p-4","grid","gap-4","grid-cols-1","sm:grid-cols-2","grid-flow-row",[95,101,106,114,119],{"type":21,"tag":96,"props":97,"children":98},"my-button",{},[99],{"type":45,"value":100},"button",{"type":21,"tag":96,"props":102,"children":104},{"type":103},"secondary",[105],{"type":45,"value":100},{"type":21,"tag":107,"props":108,"children":111},"text-field",{"placeholder":109,"type":110},"Password","password",[112],{"type":45,"value":113},"hello",{"type":21,"tag":107,"props":115,"children":118},{"placeholder":116,"type":117},"123","number",[],{"type":21,"tag":120,"props":121,"children":122},"toggle",{},[],{"type":21,"tag":72,"props":124,"children":126},{"id":125},"molecules",[127],{"type":45,"value":128},"Molecules",{"type":21,"tag":30,"props":130,"children":131},{},[132],{"type":45,"value":133},"Multiple Atoms can be used to form Molecules. They form the fundamental elements in the Design that serve a certain purpose. For example a Button and an InputField can form a Searchbox.",{"type":21,"tag":22,"props":135,"children":138},{"className":136},[86,87,88,89,90,91,137,93],"lg:grid-cols-2",[139,141,145,146],{"type":45,"value":140},"\n  ",{"type":21,"tag":142,"props":143,"children":144},"search-field",{},[],{"type":45,"value":140},{"type":21,"tag":147,"props":148,"children":152},"card",{"className":149,"link":5},[150,151],"h-12","lg:h-24",[153],{"type":45,"value":154},"Some clickable Card",{"type":21,"tag":72,"props":156,"children":158},{"id":157},"organisms",[159],{"type":45,"value":160},"Organisms",{"type":21,"tag":30,"props":162,"children":163},{},[164],{"type":45,"value":165},"Organisms are groups of Molecules and provide more complex and distinct parts of the UI. Organisms can also contain Atoms or other Organisms. You can think of a page Navigation containing a Logo, Links, Buttons and a Searchbox.",{"type":21,"tag":22,"props":167,"children":169},{"className":168},[86,88,87],[170],{"type":21,"tag":171,"props":172,"children":174},"signup-form",{":options":173},"options",[],{"type":21,"tag":72,"props":176,"children":178},{"id":177},"beyond-chemistry",[179],{"type":45,"value":180},"Beyond Chemistry",{"type":21,"tag":182,"props":183,"children":185},"h4",{"id":184},"templates",[186],{"type":45,"value":187},"Templates",{"type":21,"tag":30,"props":189,"children":190},{},[191],{"type":45,"value":192},"One step further, the chemistry analogy ends and another step towards a final Page comes into play. Templates are basically layout definitions, similar to Wireframes, that define how a page should be structured from a high-level view. Templates do not have any content and therefore focus on the skeleton of building blocks and how they can be combined and arranged.",{"type":21,"tag":182,"props":194,"children":196},{"id":195},"pages",[197],{"type":45,"value":198},"Pages",{"type":21,"tag":30,"props":200,"children":201},{},[202],{"type":45,"value":203},"Pages are concrete instances of templates and therefore filled with content. While Templates are content agnostic and do not represent any branding or design language, two pages can have quite different look & feel based on the content. Imagine two E-Commerce pages sharing a common Design System and template. One of them sells coffee beans, the other offers dog food. Despite the common ground the both will have distinct appearances due to the context and the choice of content, colors, fonts, images, language etc.",{"type":21,"tag":30,"props":205,"children":206},{},[207],{"type":45,"value":208},"Further, Pages can present variations and combinations of elements of the Design System:",{"type":21,"tag":210,"props":211,"children":212},"ul",{},[213,219,224,229,234],{"type":21,"tag":214,"props":215,"children":216},"li",{},[217],{"type":45,"value":218},"headlines and other content might be longer/shorter than expected",{"type":21,"tag":214,"props":220,"children":221},{},[222],{"type":45,"value":223},"content in different languages can have big impact on the resulting layout",{"type":21,"tag":214,"props":225,"children":226},{},[227],{"type":45,"value":228},"empty shopping cart vs. filled shopping cart",{"type":21,"tag":214,"props":230,"children":231},{},[232],{"type":45,"value":233},"users with different roles and permissions",{"type":21,"tag":214,"props":235,"children":236},{},[237],{"type":45,"value":238},"first-time users vs. regular users",{"type":21,"tag":72,"props":240,"children":242},{"id":241},"resources",[243],{"type":45,"value":244},"Resources",{"type":21,"tag":210,"props":246,"children":247},{},[248],{"type":21,"tag":214,"props":249,"children":250},{},[251],{"type":21,"tag":53,"props":252,"children":255},{"href":253,"rel":254},"https://atomicdesign.bradfrost.com/table-of-contents/",[57],[256],{"type":45,"value":257},"Atomic Design by Brad Frost",{"title":5,"searchDepth":259,"depth":259,"links":260},2,[261,263,264,265,266],{"id":74,"depth":262,"text":77},3,{"id":125,"depth":262,"text":128},{"id":157,"depth":262,"text":160},{"id":177,"depth":262,"text":180},{"id":241,"depth":262,"text":244},"markdown","content:atomic-design.md","content","atomic-design.md","atomic-design","md",1762599984707]